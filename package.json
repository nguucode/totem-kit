{
  "name": "zweihander",
  "version": "0.7.0",
  "license": "MIT",
  "type": "module",
  "description": "Zweihänder components (early stage, not production-ready — see README), published for npm install as an alternative to the copy-source registry.",
  "homepage": "https://nguucode.github.io/zweihander",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./button": {
      "types": "./dist/components/buttons/Button.d.ts",
      "import": "./dist/components/buttons/Button.js"
    },
    "./text-input": {
      "types": "./dist/components/inputs/TextInput.d.ts",
      "import": "./dist/components/inputs/TextInput.js"
    },
    "./theme": {
      "types": "./dist/theme/Theme.d.ts",
      "import": "./dist/theme/Theme.js"
    },
    "./utils": {
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "prepack": "npm run build:lib",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "registry:check": "node scripts/check-registry.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json && cp src/tokens.css dist/tokens.css",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "oxlint": "^1.81.0",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "storybook": "^10.6.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "latest"
  }
}
