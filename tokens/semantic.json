{
  "$description": "What components read. Colour entries are aliases into primitives.json, so no semantic token carries a literal value — swapping a ramp swaps everything downstream. `accent.*` and `gray.*` are placeholders resolved per palette by the generator.",
  "color": {
    "light": {
      "background": { "$type": "color", "$value": "oklch(100% 0 0)" },
      "foreground": { "$type": "color", "$value": "{gray.950}" },
      "card": { "$type": "color", "$value": "oklch(100% 0 0)" },
      "card-foreground": { "$type": "color", "$value": "{gray.950}" },
      "popover": { "$type": "color", "$value": "oklch(100% 0 0)" },
      "popover-foreground": { "$type": "color", "$value": "{gray.950}" },
      "primary": { "$type": "color", "$value": "{accent.solid}" },
      "primary-foreground": { "$type": "color", "$value": "{accent.contrast}" },
      "secondary": { "$type": "color", "$value": "{gray.100}" },
      "secondary-foreground": { "$type": "color", "$value": "{gray.900}" },
      "muted": { "$type": "color", "$value": "{gray.100}" },
      "muted-foreground": { "$type": "color", "$value": "{gray.500}" },
      "accent": { "$type": "color", "$value": "{gray.100}" },
      "accent-foreground": { "$type": "color", "$value": "{gray.900}" },
      "destructive": { "$type": "color", "$value": "{accent.red.600}" },
      "destructive-foreground": { "$type": "color", "$value": "{gray.neutral.50}" },
      "border": { "$type": "color", "$value": "{gray.200}" },
      "input": { "$type": "color", "$value": "{gray.200}" },
      "ring": { "$type": "color", "$value": "{accent.ring}" }
    },
    "dark": {
      "background": { "$type": "color", "$value": "{gray.950}" },
      "foreground": { "$type": "color", "$value": "{gray.50}" },
      "card": { "$type": "color", "$value": "{gray.900}" },
      "card-foreground": { "$type": "color", "$value": "{gray.50}" },
      "popover": { "$type": "color", "$value": "{gray.900}" },
      "popover-foreground": { "$type": "color", "$value": "{gray.50}" },
      "primary": { "$type": "color", "$value": "{accent.solid}" },
      "primary-foreground": { "$type": "color", "$value": "{accent.contrast}" },
      "secondary": { "$type": "color", "$value": "{gray.800}" },
      "secondary-foreground": { "$type": "color", "$value": "{gray.50}" },
      "muted": { "$type": "color", "$value": "{gray.800}" },
      "muted-foreground": { "$type": "color", "$value": "{gray.400}" },
      "accent": { "$type": "color", "$value": "{gray.800}" },
      "accent-foreground": { "$type": "color", "$value": "{gray.50}" },
      "destructive": { "$type": "color", "$value": "{accent.red.400}" },
      "destructive-foreground": { "$type": "color", "$value": "{gray.neutral.900}" },
      "border": { "$type": "color", "$value": "oklch(100% 0 0 / 10%)" },
      "input": { "$type": "color", "$value": "oklch(100% 0 0 / 15%)" },
      "ring": { "$type": "color", "$value": "{accent.ring}" }
    }
  },

  "shadow": {
    "$description": "Elevation. Dark raises the alpha because a flat black shadow has almost nothing left to darken on a dark surface.",
    "light": {
      "elevation-sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
      "elevation-md": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)" },
      "elevation-lg": { "$type": "shadow", "$value": "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)" },
      "elevation-xl": { "$type": "shadow", "$value": "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)" }
    },
    "dark": {
      "elevation-sm": { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.3)" },
      "elevation-md": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(0 0 0 / 0.4), 0 2px 4px -2px rgb(0 0 0 / 0.4)" },
      "elevation-lg": { "$type": "shadow", "$value": "0 10px 15px -3px rgb(0 0 0 / 0.4), 0 4px 6px -4px rgb(0 0 0 / 0.4)" },
      "elevation-xl": { "$type": "shadow", "$value": "0 20px 25px -5px rgb(0 0 0 / 0.5), 0 8px 10px -6px rgb(0 0 0 / 0.5)" }
    }
  },

  "root": {
    "$description": "Appearance-independent. These live on :root alone — never on .light — so a nested light scope inherits them instead of resetting them.",
    "radius": { "$type": "dimension", "$value": "0.625rem" },
    "radius-factor": { "$type": "number", "$value": 1 },
    "radius-full": { "$type": "dimension", "$value": "0px" },
    "scaling": { "$type": "number", "$value": 1 },
    "cursor-button": { "$type": "other", "$value": "default" },
    "cursor-disabled": { "$type": "other", "$value": "not-allowed" },
    "font-sans": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji'"
    },
    "font-mono": {
      "$type": "fontFamily",
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    }
  },

  "space": {
    "$description": "Multiples of 0.25rem. The generator multiplies each by --scaling.",
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "1-5": { "$type": "dimension", "$value": "0.375rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" }
  },

  "text": {
    "$description": "Type roles. Each size pairs with a leading ratio of the same name, so the line height follows the size under --scaling.",
    "heading-2xl": { "$type": "dimension", "$value": "2rem", "$extensions": { "leading": "36 / 32" } },
    "heading-xl": { "$type": "dimension", "$value": "1.75rem", "$extensions": { "leading": "32 / 28" } },
    "heading-lg": { "$type": "dimension", "$value": "1.5rem", "$extensions": { "leading": "28 / 24" } },
    "heading-md": { "$type": "dimension", "$value": "1.25rem", "$extensions": { "leading": "24 / 20" } },
    "heading-sm": { "$type": "dimension", "$value": "1rem", "$extensions": { "leading": "20 / 16" } },
    "heading-xs": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "leading": "20 / 14" } },
    "heading-2xs": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "leading": "16 / 12" } },
    "body-lg": { "$type": "dimension", "$value": "1rem", "$extensions": { "leading": "24 / 16" } },
    "body": { "$type": "dimension", "$value": "0.875rem", "$extensions": { "leading": "20 / 14" } },
    "body-sm": { "$type": "dimension", "$value": "0.75rem", "$extensions": { "leading": "16 / 12" } }
  }
}
