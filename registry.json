{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "totem-kit",
  "homepage": "https://nguucode.github.io/totem-kit",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "slot",
      "type": "registry:lib",
      "title": "Slot",
      "description": "Renders its single child merged with the given props — what asChild is built on.",
      "files": [
        {
          "path": "src/lib/slot.tsx",
          "type": "registry:lib",
          "target": "lib/slot.tsx"
        }
      ]
    },
    {
      "name": "tokens",
      "type": "registry:file",
      "title": "Design tokens",
      "description": "The whole token layer as one stylesheet: colors, radius, spacing, type, shadows, cursors, light and dark.",
      "files": [
        {
          "path": "src/tokens.css",
          "type": "registry:file",
          "target": "styles/totem-tokens.css"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:component",
      "title": "Theme",
      "description": "Scopes an appearance and token overrides to a subtree.",
      "registryDependencies": [
        "utils",
        "slot"
      ],
      "files": [
        {
          "path": "src/theme/Theme.tsx",
          "type": "registry:component",
          "target": "components/totem/theme.tsx"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "Button with cva variants and Radix Slot asChild support.",
      "registryDependencies": [
        "utils",
        "slot",
        "tokens"
      ],
      "files": [
        {
          "path": "src/components/actions/Button.tsx",
          "type": "registry:component",
          "target": "components/totem/button.tsx"
        },
        {
          "path": "src/components/actions/Button.module.css",
          "type": "registry:component",
          "target": "components/totem/button.module.css"
        }
      ]
    },
    {
      "name": "text-input",
      "type": "registry:component",
      "title": "Text Input",
      "description": "Labeled text input (Radix Label) with helper/error text.",
      "registryDependencies": [
        "utils",
        "tokens"
      ],
      "files": [
        {
          "path": "src/components/inputs/TextInput.tsx",
          "type": "registry:component",
          "target": "components/totem/text-input.tsx"
        },
        {
          "path": "src/components/inputs/TextInput.module.css",
          "type": "registry:component",
          "target": "components/totem/text-input.module.css"
        }
      ]
    }
  ]
}
