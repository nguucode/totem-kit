{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zweihander",
  "homepage": "https://ontheshore.biz/zweihander",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ],
      "description": "The cn() class-name helper every component uses.",
      "dependencies": [
        "clsx"
      ]
    },
    {
      "name": "slot",
      "type": "registry:lib",
      "title": "Slot",
      "description": "Renders its single child merged with the given props \u2014 what asChild is built on.",
      "files": [
        {
          "path": "src/lib/slot.tsx",
          "type": "registry:lib",
          "target": "lib/slot.tsx"
        }
      ]
    },
    {
      "name": "tokens",
      "type": "registry:file",
      "title": "Design tokens",
      "description": "The whole token layer as one stylesheet: colors, radius, spacing, type, shadows, cursors, light and dark.",
      "files": [
        {
          "path": "src/tokens.css",
          "type": "registry:file",
          "target": "styles/zweihander-tokens.css"
        }
      ]
    },
    {
      "name": "theme",
      "type": "registry:component",
      "title": "Theme",
      "description": "Scopes an appearance and token overrides to a subtree.",
      "registryDependencies": [
        "https://ontheshore.biz/zweihander/r/utils.json",
        "https://ontheshore.biz/zweihander/r/slot.json",
        "https://ontheshore.biz/zweihander/r/tokens.json"
      ],
      "files": [
        {
          "path": "src/theme/Theme.tsx",
          "type": "registry:component",
          "target": "components/zweihander/theme.tsx"
        },
        {
          "path": "src/theme/palettes.ts",
          "type": "registry:component",
          "target": "components/zweihander/palettes.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "Button with six variants and four sizes, and asChild for rendering as a link.",
      "registryDependencies": [
        "https://ontheshore.biz/zweihander/r/utils.json",
        "https://ontheshore.biz/zweihander/r/slot.json",
        "https://ontheshore.biz/zweihander/r/tokens.json"
      ],
      "files": [
        {
          "path": "src/components/buttons/Button.tsx",
          "type": "registry:component",
          "target": "components/zweihander/button.tsx"
        },
        {
          "path": "src/components/buttons/Button.module.css",
          "type": "registry:component",
          "target": "components/zweihander/Button.module.css"
        }
      ]
    },
    {
      "name": "text-input",
      "type": "registry:component",
      "title": "Text Input",
      "description": "Labeled text input with helper and error text, wired for screen readers.",
      "registryDependencies": [
        "https://ontheshore.biz/zweihander/r/utils.json",
        "https://ontheshore.biz/zweihander/r/tokens.json"
      ],
      "files": [
        {
          "path": "src/components/inputs/TextInput.tsx",
          "type": "registry:component",
          "target": "components/zweihander/text-input.tsx"
        },
        {
          "path": "src/components/inputs/TextInput.module.css",
          "type": "registry:component",
          "target": "components/zweihander/TextInput.module.css"
        }
      ]
    }
  ]
}
