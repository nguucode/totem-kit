{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zweihander",
  "homepage": "https://ontheshore.biz/zweihander",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
